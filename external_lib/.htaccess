# The web fonts (bootstrap, font awesome) of this folder are fetched by the browser in
# CORS mode, because a @font-face request always is - unlike the stylesheet that names it.
# So a page that is not served by this host (e.g. an html test snapshot opened from an ide
# preview server on another port) gets the css but no glyph, and an icon stays invisible.
# Allow any origin for the fonts only: they are public third party files, read without
# credentials and carry no user data, so nothing can leak through this header.
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2?|ttf|eot)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
