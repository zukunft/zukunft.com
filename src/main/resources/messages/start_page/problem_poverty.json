  "formulas": [
    {
      "name": "probability range low",
      "description": "the lower bound of the probability range of an estimate, the estimate multiplied by its low range factor; the centre is the stated target value and each bound is calculated on its own, so that a range can be asymmetric",
      "expression": "\"low\" = \"assumed\" * \"probability range factor\"",
      "latex": "x_{low} = x \\cdot f_{low}",
      "assigned_word": "probability range factor"
    },
    {
      "name": "probability range high",
      "description": "the upper bound of the probability range of an estimate, the estimate multiplied by its high range factor; the centre is the stated target value and each bound is calculated on its own, so that a range can be asymmetric",
      "expression": "\"high\" = \"assumed\" * \"probability range factor\"",
      "latex": "x_{high} = x \\cdot f_{high}",
      "assigned_word": "probability range factor"
    },
    {
      "name": "annual damage in money",
      "description": "the loss that a problem causes each year in money, the world GDP multiplied by the share of it that the problem costs per year",
      "expression": "\"potential\",\"loss\",\"trillion\",\"EUR\" = \"world\",\"GDP\",\"trillion\",\"EUR\" * \"percent\",\"GDP\",\"annual\"",
      "latex": "L_{pot} = GDP_{world} \\cdot d_{annual}",
      "assigned_word": "GDP"
    },
    {
      "name": "loss reduction by poverty research",
      "description": "the share of the potential loss that the solution avoids, the share by which the poverty research reduces the extreme poverty; the change of the extreme poverty is negative, because it is a reduction, while the avoided share of the loss is stated positive",
      "expression": "\"loss reduction\",\"percent\" = 0 - \"poverty research\",\"extreme poverty\"",
      "latex": "r = -\\Delta p",
      "assigned_word": "research"
    },
    {
      "name": "long run damage share of the GDP",
      "description": "the share of the world GDP that a problem costs at the end of its development, the share it costs today multiplied by the factor by which the damage still grows; the share is stated negative, because it is a loss",
      "expression": "\"potential\",\"loss\",\"percent\",\"GDP\" = 0 - \"percent\",\"GDP\",\"annual\" * \"percent\",\"GDP\",\"factor\"",
      "latex": "d_{long} = -d_{annual} \\cdot g",
      "assigned_word": "annual"
    },
    {
      "name": "welfare damage share",
      "description": "the share of the global happy time points that a problem costs, the share of the GDP it costs multiplied by the factor by which the welfare damage exceeds the money damage, because htp counts the healthy life years that the GDP does not (concept paper introduction)",
      "expression": "\"potential\",\"loss\",\"percent\",\"htp\" = \"potential\",\"loss\",\"percent\",\"GDP\" * \"htp\",\"GDP\",\"factor\"",
      "latex": "d_{htp} = d_{GDP} \\cdot w",
      "assigned_word": "htp"
    },
    {
      "name": "initial effort of a solution",
      "description": "the person years needed to set up a solution, the annual damage of the problem in money multiplied by the effort needed per trillion EUR of damage",
      "expression": "\"initial effort\",\"person year\" = \"potential\",\"loss\",\"trillion\",\"EUR\" * \"person year\",\"trillion\",\"EUR\",\"factor\"",
      "latex": "E_{init} = L_{pot} \\cdot e",
      "assigned_word": "person year"
    },
    {
      "name": "avoided welfare loss with a gain factor",
      "description": "the happy time points that a solution saves, like the avoided welfare loss, but multiplied by a factor of the problem, because the shared world htp is tuned to one problem and does not fit the others until the horizon of the ranking is stated; the result is stated positive, because it is a gain",
      "expression": "\"potential\",\"gain\",\"billion\",\"htp\" = 0 - \"potential\",\"loss\",\"percent\",\"htp\" * \"world\",\"htp\",\"billion\" * \"loss reduction\",\"percent\" * \"htp\",\"billion\",\"factor\"",
      "latex": "G = -d_{htp} \\cdot HTP_{world} \\cdot r \\cdot k",
      "assigned_word": "loss reduction"
    }
  ],
